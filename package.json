{
  "name": "humanizador",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node tools/run.mjs --dev",
    "start": "node tools/run.mjs",
    "api": "node server/api.mjs",
    "worker": "node server/worker.mjs",
    "build": "vite build",
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm run build",
    "apply": "node tools/apply.mjs",
    "backup": "node tools/backup.mjs",
    "eval:local": "node tools/editorial-audit.mjs",
    "check:public": "node tools/check-public.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.3"
  },
  "license": "MIT",
  "description": "Revisión editorial de PDF con notas, reglas y Ollama local opcional.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rcanalescoder/Humanizador.git"
  },
  "homepage": "https://rcanalescoder.github.io/Humanizador/"
}
